{
  "manifest_version": 3,
  "name": "Кэшбэк Сервис Савелло Клуб",
  "version": "1.6.0",
  "description": "Получайте кэшбэк с покупок в интернет-магазинах. Активация — только по вашему явному клику в попапе расширения или на сайте savelloclub.ru.",
  "default_locale": "ru",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "cookies",
    "offscreen"
  ],
  "host_permissions": [
    "https://savelloclub.ru/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-gray-16.png",
      "32": "icons/icon-gray-32.png",
      "48": "icons/icon-gray-48.png",
      "128": "icons/icon-gray-128.png"
    },
    "default_title": "Честный и выгодный Кэшбэк Сервис Савелло Клуб"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://savelloclub.ru/*"],
      "js": ["utils/config.js", "content/savello-site.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-gray-16.png",
    "32": "icons/icon-gray-32.png",
    "48": "icons/icon-gray-48.png",
    "128": "icons/icon-gray-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.svg", "icons/*.png"],
      "matches": ["https://savelloclub.ru/*"]
    }
  ]
}
