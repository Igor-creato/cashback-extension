{
  "manifest_version": 3,
  "name": "Кэшбэк Сервис Савелло Клуб",
  "version": "1.5.2",
  "description": "Получайте кэшбэк с покупок в интернет-магазинах. Автоматическое определение магазинов, активация кэшбэка одним кликом.",
  "default_locale": "ru",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "activeTab",
    "cookies",
    "webNavigation",
    "offscreen"
  ],
  "host_permissions": [
    "https://mybestestsite.autmatization-bot.ru/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-gray-16.png",
      "32": "icons/icon-gray-32.png",
      "48": "icons/icon-gray-48.png",
      "128": "icons/icon-gray-128.png"
    },
    "default_title": "Честный и выгодный Кэшбэк Сервис Савелло Клуб"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils/config.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-gray-16.png",
    "32": "icons/icon-gray-32.png",
    "48": "icons/icon-gray-48.png",
    "128": "icons/icon-gray-128.png"
  },
  "web_accessible_resources": [
    {
        "resources": ["icons/*.svg", "icons/*.png"],
        "matches": ["<all_urls>"]
    }
]
}
